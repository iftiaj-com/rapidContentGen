{
  "$comment": "Adits effects run unmodified by tools/fx/fx.mjs (rcg fx). params: Adits UI inputs (DOM ids) with their UI defaults; ranges: [min, max, step] so the harness makes real range inputs that clamp and snap as the Adits UI does; vparams: videoEngine.params; presets: Adits preset tables (core/main.js) applied over the defaults; needs/optional: src2 = a second media (side B); webgpu: needs a WebGPU device; options: harness behaviour (media \"video\" = a real seeked <video>; ready/settle = properties to wait for; bSpeedParam).",
  "ghost": {
    "label": "Ghost trails (AdvGhost): delayed copies screened in magenta and cyan; lag and offset follow the music",
    "kind": "footage",
    "module": "effects/video/AdvGhost.js",
    "class": "AdvGhost",
    "preroll": 2.5,
    "params": {
      "advGhostLag": 10,
      "advGhostAlpha": 0.5
    },
    "ranges": {
      "advGhostLag": [
        1,
        60,
        1
      ],
      "advGhostAlpha": [
        0.1,
        1,
        0.1
      ]
    }
  },
  "motion-trails": {
    "label": "Motion trails (MotionTrails, ICM): long-exposure smear of the last frames; darken, lighten or smear; can isolate trails",
    "kind": "footage",
    "module": "effects/video/MotionTrails.js",
    "class": "MotionTrails",
    "preroll": 2,
    "params": {},
    "vparams": {
      "motionTrails": {
        "blendMode": "darken",
        "trailLength": 20,
        "persistence": 0.85,
        "trailStrength": 0.9,
        "frameStep": 1,
        "preSmooth": 1,
        "colorMode": "normal",
        "customColor": "#ff00ff",
        "bgColor": "#000000",
        "trailsOnly": false,
        "isolTrailDuration": 50,
        "isolStrokeBrightness": 70,
        "isolMotionSensitivity": 100,
        "isolStrokeWeight": 30,
        "isolDetailLevel": 60,
        "isolFlowTurbulence": 20,
        "audioReactive": true,
        "targetFreq": "bass",
        "trailOnBeat": false,
        "trailHold": false,
        "liveHold": false,
        "autoCycle": false,
        "cycleSpeed": 2,
        "surgeDepth": 0.6
      }
    }
  },
  "origami": {
    "label": "Origami (Origami): the frame folds into paper shapes (crumple, crane, heart, mandala...) over the transform time",
    "kind": "footage",
    "module": "effects/video/Origami.js",
